{
  "mcpServers": {
    "dsh_collab": {
      "command": "./mcp/dsh-collab-mcp.exe",
      "args": [
        "./mcp/server.mjs"
      ],
      "cwd": ".",
      "env_vars": [
        "APPDATA",
        "USERPROFILE",
        "PATH",
        "DSH_MCP_NODE",
        "DSH_DESKTOP_RUNTIME_FILE"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 7200
    }
  }
}
